{
  "id": "picket-openclaw",
  "name": "Picket",
  "description": "Reports Gmail and Calendar commands run through gog to Picket on this Mac.",
  "categories": ["security"],
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agent"],
    "properties": {
      "agent": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
      "dataDirectory": { "type": "string" }
    }
  }
}

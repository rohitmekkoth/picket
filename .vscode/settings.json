{
  "editor.formatOnSave": true,
  "[rust]": { "editor.defaultFormatter": "rust-lang.rust-analyzer" },
  "[typescript][typescriptreact][json][css]": { "editor.defaultFormatter": "biomejs.biome" },
  "rust-analyzer.check.command": "clippy",
  "files.watcherExclude": { "**/target/**": true, "**/node_modules/**": true, "**/dist/**": true },
  "search.exclude": { "**/target": true, "**/node_modules": true, "**/dist": true }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Expose the runtime diagnostic, Google connection, agent registration, overview and activity, incident review, rules, local model, settings, setup, export and wipe commands.",
  "windows": ["main"],
  "permissions": [
    "allow-get-runtime-info",
    "allow-google-connected",
    "allow-connect-google",
    "allow-list-agents",
    "allow-register-agent",
    "allow-get-overview",
    "allow-list-activity",
    "allow-list-incidents",
    "allow-get-incident",
    "allow-resolve-incident",
    "allow-set-agent-revoked",
    "allow-open-link",
    "allow-get-rules",
    "allow-set-rule-level",
    "allow-preview-boundary",
    "allow-save-boundary",
    "allow-delete-boundary",
    "allow-model-status",
    "allow-download-model",
    "allow-reconnect-google",
    "allow-get-settings",
    "allow-update-settings",
    "allow-set-start-at-login",
    "allow-verify-log",
    "allow-export-incident",
    "allow-export-all",
    "allow-wipe-all",
    "allow-sign-in-google",
    "allow-complete-setup"
  ]
}

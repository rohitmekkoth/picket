{
  "name": "picket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "scripts": {
    "tauri": "node scripts/tauri.mjs",
    "dev": "pnpm tauri dev",
    "dev:ui": "pnpm --filter @picket/ui dev",
    "build:ui": "pnpm --filter @picket/ui build",
    "build:plugin": "pnpm --filter picket-openclaw build",
    "build": "pnpm build:plugin && pnpm tauri build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build:ui && pnpm build:plugin",
    "check:env": "node scripts/doctor.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
